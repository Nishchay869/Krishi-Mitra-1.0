# Copy to .env and fill in, then: set -a; source .env; set +a
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Weather module — free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Multilingual chat + voice queries — key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# Leave DB_NAME empty to use SQLite; set it to use PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
