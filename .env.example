# Copy to .env and fill in, then: set -a; source .env; set +a
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only, full https URL(s), e.g. https://yourname-krishimitra.hf.space
DJANGO_CSRF_TRUSTED_ORIGINS=

# Weather module — free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Multilingual chat + voice queries — key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# Leave DB_NAME empty to use SQLite; set it to use PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=          # set to: require   for Neon / Supabase

# Official data.gov.in mandi prices (server-side only)
DATA_GOV_IN_API_KEY=

# Disease Check — Google Gemini image analysis (server-side key only)
GEMINI_API_KEY=
GEMINI_DISEASE_MODEL=gemini-3.5-flash-lite

# Password-reset email over SMTP. Leave EMAIL_HOST empty to print emails to the console.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com, EMAIL_HOST_PASSWORD=<16-letter app password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Krishi Mitra <you@gmail.com>

# Error alerts from sentry.io (free). Leave empty to disable.
SENTRY_DSN=
