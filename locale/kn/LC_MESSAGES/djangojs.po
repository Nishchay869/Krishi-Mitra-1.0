msgid "Converting your speech to text…"
msgstr "ನಿಮ್ಮ ಮಾತನ್ನು ಬರಹಕ್ಕೆ ಬದಲಿಸುತ್ತಿದೆ…"

msgid "Could not save favourites. Please try again."
msgstr "ಮೆಚ್ಚಿನವುಗಳನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "Couldn't hear that. Please try again."
msgstr "ಕೇಳಿಸಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "Dictate: speak and the words appear in the box"
msgstr "ಮಾತನಾಡಿ, ಪದಗಳು ಪೆಟ್ಟಿಗೆಯಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ"

msgid "Done speaking"
msgstr "ಮಾತು ಮುಗಿಯಿತು"

msgid "End"
msgstr "ಮುಗಿಸಿ"

msgid "Finding your location…"
msgstr "ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಹುಡುಕಲಾಗುತ್ತಿದೆ..."

msgid "Krishi Mitra · Live"
msgstr "ಕೃಷಿ ಮಿತ್ರ · ನೇರ ಸಂಭಾಷಣೆ"

msgid "Listen"
msgstr "ಕೇಳಿ"

msgid "Listening…"
msgstr "ಕೇಳುತ್ತಿದೆ…"

msgid "Listening… speak, then pause or tap ■"
msgstr "ಕೇಳುತ್ತಿದೆ… ಮಾತನಾಡಿ, ನಂತರ ವಿರಾಮ ನೀಡಿ ಅಥವಾ ■ ಒತ್ತಿರಿ"

msgid "Live voice conversation"
msgstr "ನೇರ ಧ್ವನಿ ಸಂಭಾಷಣೆ"

msgid "Location could not be saved. Please try again."
msgstr "ಸ್ಥಳವನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೊಮ್ಮೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "Location is unavailable. Please check your browser permissions."
msgstr "ಸ್ಥಳವು ಲಭ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನುಮತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."

msgid "Market removed from favourites."
msgstr "ಮಾರುಕಟ್ಟೆಯನ್ನು ನೆಚ್ಚಿನವುಗಳಿಂದ ತೆಗೆದುಹಾಕಲಾಗಿದೆ."

msgid "Market saved to favourites."
msgstr "ಮಾರುಕಟ್ಟೆಯನ್ನು ಮೆಚ್ಚಿನವುಗಳಿಗೆ ಉಳಿಸಲಾಗಿದೆ."

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "ಮೈಕ್ರೊಫೋನ್ ಅನುಮತಿ ಇಲ್ಲ. ಮಾತನಾಡಲು ಬ್ರೌಸರ್ ಸೆಟ್ಟಿಂಗ್‌ನಲ್ಲಿ ಅನುಮತಿಸಿ."

msgid "Microphone blocked — allow it in browser settings."
msgstr "ಮೈಕ್ರೊಫೋನ್ ತಡೆಹಿಡಿಯಲಾಗಿದೆ — ಬ್ರೌಸರ್ ಸೆಟ್ಟಿಂಗ್‌ನಲ್ಲಿ ಅನುಮತಿಸಿ."

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "ನಮಸ್ಕಾರ! ಬೆಳೆ, ಗೊಬ್ಬರ, ಕೀಟ ಅಥವಾ ಸರ್ಕಾರಿ ಯೋಜನೆಗಳ ಬಗ್ಗೆ ನಿಮ್ಮ ಭಾಷೆಯಲ್ಲಿ ಬರೆಯಿರಿ ಅಥವಾ ಮಾತನಾಡಿ."

msgid "Namaste! 🙏"
msgstr "ನಮಸ್ಕಾರ! 🙏"

msgid "Network error. Please try again."
msgstr "ಜಾಲ ಸಂಪರ್ಕದ ಸಮಸ್ಯೆ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "Paused — tap the circle to talk"
msgstr "ವಿರಾಮ — ಮಾತನಾಡಲು ವೃತ್ತ ಒತ್ತಿರಿ"

msgid "Send now, interrupt, or resume"
msgstr "ಈಗ ಕಳುಹಿಸಿ, ನಿಲ್ಲಿಸಿ ಅಥವಾ ಮುಂದುವರಿಸಿ"

msgid "Something went wrong."
msgstr "ಏನೋ ತಪ್ಪಾಗಿದೆ."

msgid "Sorry, I didn't catch that."
msgstr "ಸ್ಪಷ್ಟವಾಗಿ ಕೇಳಿಸಲಿಲ್ಲ. ಮತ್ತೆ ಹೇಳಿ."

msgid "Source:"
msgstr "ಮೂಲ:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "ಯಾವುದೇ ಭಾಷೆಯಲ್ಲಿ ಮಾತನಾಡಿ. ಮುಗಿದಾಗ ವಿರಾಮ ನೀಡಿ — ಉತ್ತರಿಸಿದ ಬಳಿಕ ಮತ್ತೆ ಕೇಳುತ್ತೇನೆ."

msgid "Speaking… tap the circle to interrupt"
msgstr "ಮಾತನಾಡುತ್ತಿದೆ… ನಿಲ್ಲಿಸಲು ವೃತ್ತ ಒತ್ತಿರಿ"

msgid "Speaking… tap the circle to skip"
msgstr "ಮಾತನಾಡುತ್ತಿದೆ… ಬಿಡಲು ವೃತ್ತ ಒತ್ತಿರಿ"

msgid "Stop"
msgstr "ನಿಲ್ಲಿಸಿ"

msgid "Thinking…"
msgstr "ಯೋಚಿಸುತ್ತಿದೆ…"

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "ಅನುವಾದ ತಾತ್ಕಾಲಿಕವಾಗಿ ಲಭ್ಯವಿಲ್ಲ. ಈ ಉತ್ತರವನ್ನು ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ತೋರಿಸಲಾಗಿದೆ."

msgid "Type instead"
msgstr "ಬದಲಿಗೆ ಬರೆಯಿರಿ"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "ಈ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಧ್ವನಿ ಸಂಭಾಷಣೆ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ. ಪ್ರಶ್ನೆ ಬರೆಯಿರಿ."

msgid "Voice replies off (tap to turn on)"
msgstr "ಧ್ವನಿ ಉತ್ತರ ಆಫ್ (ಚಾಲೂ ಮಾಡಲು ಒತ್ತಿರಿ)"

msgid "Voice replies on (tap to mute)"
msgstr "ಧ್ವನಿ ಉತ್ತರ ಚಾಲೂ (ಮೂಕಗೊಳಿಸಲು ಒತ್ತಿರಿ)"

msgid "Voice typing is not supported in this browser."
msgstr "ಈ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಧ್ವನಿ ಬರವಣಿಗೆ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ."

msgid "Your current location"
msgstr "ನಿಮ್ಮ ಪ್ರಸ್ತುತ ಸ್ಥಳ"
