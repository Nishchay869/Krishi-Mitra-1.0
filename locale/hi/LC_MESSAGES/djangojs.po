msgstr "Project-Id-Version: Krishi Mitra\nLanguage: hi\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Converting your speech to text…"
msgstr "आवाज़ को लिख रहा है…"

msgid "Could not save favourites. Please try again."
msgstr "पसंदीदा नहीं बचाए जा सके। कृपया फिर से प्रयास करें।"

msgid "Couldn't hear that. Please try again."
msgstr "सुनाई नहीं दिया। फिर कोशिश करें।"

msgid "Dictate: speak and the words appear in the box"
msgstr "बोलें, आपके शब्द बॉक्स में दिखाई देंगे"

msgid "Done speaking"
msgstr "बोलना समाप्त"

msgid "End"
msgstr "समाप्त करें"

msgid "Finding your location…"
msgstr "आपका स्थान खोजा जा रहा है..."

msgid "Krishi Mitra · Live"
msgstr "कृषि मित्र · सीधी बातचीत"

msgid "Listen"
msgstr "सुनें"

msgid "Listening…"
msgstr "सुन रहा है…"

msgid "Listening… speak, then pause or tap ■"
msgstr "सुन रहा है… बोलें, फिर रुकें या ■ दबाएँ"

msgid "Live voice conversation"
msgstr "आवाज़ में सीधी बातचीत"

msgid "Location could not be saved. Please try again."
msgstr "स्थान को सहेजा नहीं जा सका। कृपया फिर से प्रयास करें।"

msgid "Location is unavailable. Please check your browser permissions."
msgstr "स्थान अनुपलब्ध है। कृपया अपने ब्राउज़र अनुमतियों की जाँच करें।"

msgid "Market removed from favourites."
msgstr "बाजार पसंदीदा से हटा दिया गया।"

msgid "Market saved to favourites."
msgstr "बाज़ार पसंदीदा में सुरक्षित किया गया।"

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "माइक्रोफ़ोन की अनुमति नहीं है। बातचीत के लिए ब्राउज़र सेटिंग में अनुमति दें।"

msgid "Microphone blocked — allow it in browser settings."
msgstr "माइक्रोफ़ोन बंद है — ब्राउज़र सेटिंग में अनुमति दें।"

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "नमस्ते! फसल, खाद, कीट या सरकारी योजनाओं के बारे में अपनी भाषा में लिखकर या बोलकर पूछें।"

msgid "Namaste! 🙏"
msgstr "नमस्ते! 🙏"

msgid "Network error. Please try again."
msgstr "नेटवर्क की समस्या है। फिर कोशिश करें।"

msgid "Paused — tap the circle to talk"
msgstr "रुका है — बात करने के लिए गोल बटन दबाएँ"

msgid "Send now, interrupt, or resume"
msgstr "अभी भेजें, रोकें या फिर शुरू करें"

msgid "Something went wrong."
msgstr "कुछ गड़बड़ हुई।"

msgid "Sorry, I didn't catch that."
msgstr "साफ़ सुनाई नहीं दिया। फिर बोलें।"

msgid "Source:"
msgstr "स्रोत:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "किसी भी भाषा में बोलें। बात पूरी करके रुकें — जवाब के बाद फिर सुनूँगा।"

msgid "Speaking… tap the circle to interrupt"
msgstr "बोल रहा है… रोकने के लिए गोल बटन दबाएँ"

msgid "Speaking… tap the circle to skip"
msgstr "बोल रहा है… छोड़ने के लिए गोल बटन दबाएँ"

msgid "Stop"
msgstr "रोकें"

msgid "Thinking…"
msgstr "सोच रहा है…"

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "अनुवाद अभी उपलब्ध नहीं है। यह जवाब अंग्रेज़ी में दिखाया गया है।"

msgid "Type instead"
msgstr "लिखकर पूछें"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "इस ब्राउज़र में आवाज़ की बातचीत उपलब्ध नहीं है। सवाल लिखें।"

msgid "Voice replies off (tap to turn on)"
msgstr "आवाज़ में जवाब बंद (चालू करने के लिए दबाएँ)"

msgid "Voice replies on (tap to mute)"
msgstr "आवाज़ में जवाब चालू (बंद करने के लिए दबाएँ)"

msgid "Voice typing is not supported in this browser."
msgstr "इस ब्राउज़र में बोलकर लिखना उपलब्ध नहीं है।"

msgid "Your current location"
msgstr "आपका वर्तमान स्थान"
