msgid ""
msgstr "Project-Id-Version: Krishi Mitra\nLanguage: mai\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Converting your speech to text…"
msgstr "अहाँक भाषणकेँ पाठमे बदलल जा रहल अछि..."

msgid "Could not save favourites. Please try again."
msgstr "पसिन्नबवला सभकेँ नहि बचा सकलहुँ। कृपया फेरसँ प्रयास करू।"

msgid "Couldn't hear that. Please try again."
msgstr "ओ नहि सुनल गेल। कृपया फेरसँ प्रयास करू।"

msgid "Dictate: speak and the words appear in the box"
msgstr "निर्देश: बाजि आ शब्द सभ डिब्बा मे देखाइ देत।"

msgid "Done speaking"
msgstr "कहल गेल।"

msgid "End"
msgstr "अन्त"

msgid "Finding your location…"
msgstr "अहाँक स्थान ताकि रहल अछि..."

msgid "Krishi Mitra · Live"
msgstr "कृषि मित्र · लाइव"

msgid "Listen"
msgstr "सुनू।"

msgid "Listening…"
msgstr "सुनैत..."

msgid "Listening… speak, then pause or tap ■"
msgstr "सुनू... बाजि लिअ, फेर रुकु वा टिपू■"

msgid "Live voice conversation"
msgstr "जीवित आवाज वार्तालाप"

msgid "Location could not be saved. Please try again."
msgstr "स्थान सुरक्षित नहि कयल जा सकल। कृपया फेरसँ प्रयास करू।"

msgid "Location is unavailable. Please check your browser permissions."
msgstr "स्थान अनुपलब्ध अछि। कृपया अपन ब्राउज़रक अनुमति जाञ्चू।"

msgid "Market removed from favourites."
msgstr "बाजार पसंदीदासँ हटा देल गेल।"

msgid "Market saved to favourites."
msgstr "मार्केट पसंदीदा मे बचाओल गेल।"

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "माइक्रोफोनक पहुँच अवरुद्ध कऽ देल गेल छल। सहायकसँ गप्प करबाक लेल एकरा ब्राउज़र सेटिंग्समे अनुमति दियौ।"

msgid "Microphone blocked — allow it in browser settings."
msgstr "माइक्रोफोन अवरुद्ध अछि - एकरा ब्राउज़र सेटिंग्समे अनुमति दियौ।"

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "नमस्कार! हमरा फसल, उर्वरक, कीड़ा-मकोड़ा वा सरकारी योजना सभक विषयमे पूछू - अपन भाषा मे लिखू वा बाजि।"

msgid "Namaste! 🙏"
msgstr "नमस्कार! 🙏"

msgid "Network error. Please try again."
msgstr "नेटवर्क त्रुटि। कृपया फेरसँ प्रयास करू।"

msgid "Paused — tap the circle to talk"
msgstr "विराम - बात करबाक लेल वृत्त पर टैप करू।"

msgid "Send now, interrupt, or resume"
msgstr "आब पठाउ, अवरोधित करू वा फेरसँ शुरू करू।"

msgid "Something went wrong."
msgstr "किछु गड़बड़ भऽ गेल।"

msgid "Sorry, I didn't catch that."
msgstr "क्षमा करू हमरा बुझबामे नहि भेल।"

msgid "Source:"
msgstr "स्रोत:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "कोनो भाषा में  बाजि लिअ। जखन अहाँ समाप्त कऽ लेब तखन रुकि जाइ - हम जवाब देब आ फेर सुनब।"

msgid "Speaking… tap the circle to interrupt"
msgstr "बाजि रहल छी... व्यवधान करबाक लेल वृत्त पर टैप करू।"

msgid "Speaking… tap the circle to skip"
msgstr "बाजि रहल अछि... छोड़बाक लेल वृत्तपर थूकी।"

msgid "Stop"
msgstr "रुकू।"

msgid "Thinking…"
msgstr "सोचैत..."

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "अनुवाद अस्थायी रूप सँ अनुपलब्ध अछि। ई उत्तर अंग्रेजी मे देखाओल गेल अछि।"

msgid "Type instead"
msgstr "एकर बदला टाइप करू।"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "एहि ब्राउज़रमे आवाजसँ गप्प करब समर्थित नहि अछि। कृपया अपन प्रश्न लिखू।"

msgid "Voice replies off (tap to turn on)"
msgstr "आवाजक जवाब बन्द (चालू करबाक लेल टैप करू)"

msgid "Voice replies on (tap to mute)"
msgstr "आवाजक जवाब (म्यूट करबाक लेल टैप करू)"

msgid "Voice typing is not supported in this browser."
msgstr "एहि ब्राउज़रमे आवाज टाइपिंग समर्थित नहि अछि।"

msgid "Your current location"
msgstr "अहाँक वर्तमान स्थान"
