msgid "Converting your speech to text…"
msgstr "আপোনাৰ ভাষণক পাঠলৈ ৰূপান্তৰিত কৰা হৈছে..."

msgid "Could not save favourites. Please try again."
msgstr "পছন্দৰ বস্তুবোৰ সংৰক্ষণ কৰিব নোৱাৰিলে। অনুগ্ৰহ কৰি পুনৰ চেষ্টা কৰক।"

msgid "Couldn't hear that. Please try again."
msgstr "সেইটো শুনা নাছিল। অনুগ্ৰহ কৰি পুনৰ চেষ্টা কৰক।"

msgid "Dictate: speak and the words appear in the box"
msgstr "নিৰ্দেশনা: কোৱা আৰু বাকচত শব্দবোৰ দেখা যাব।"

msgid "Done speaking"
msgstr "কথা শেষ"

msgid "End"
msgstr "শেষ"

msgid "Finding your location…"
msgstr "আপোনাৰ অৱস্থান বিচাৰি উলিওৱা হৈছে..."

msgid "Krishi Mitra · Live"
msgstr "কৃষি মিত্ৰ · লাইভ"

msgid "Listen"
msgstr "শুনা"

msgid "Listening…"
msgstr "শুনি আছোঁ..."

msgid "Listening… speak, then pause or tap ■"
msgstr "শুনি আছ... কওক, তাৰ পিছত অলপ ৰ'ব নে টিপি দিব■"

msgid "Live voice conversation"
msgstr "সজীৱ কণ্ঠৰ কথোপকথন"

msgid "Location could not be saved. Please try again."
msgstr "থকা ঠাইটো ৰক্ষা কৰিব পৰা নগ'ল। অনুগ্ৰহ কৰি পুনৰ চেষ্টা কৰক।"

msgid "Location is unavailable. Please check your browser permissions."
msgstr "স্থান উপলব্ধ নহয়। অনুগ্ৰহ কৰি আপোনাৰ ব্ৰাউজাৰৰ অনুমতিসমূহ পৰীক্ষা কৰক।"

msgid "Market removed from favourites."
msgstr "প্ৰিয় তালিকাৰ পৰা বজাৰ আঁতৰাই পেলোৱা হ'ল।"

msgid "Market saved to favourites."
msgstr "বজাৰটো পছন্দৰ তালিকাত ৰখা হ'ল।"

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "মাইক্ৰ'ফোনৰ সুবিধা বন্ধ কৰা হৈছিল। সহায়কজনৰ সৈতে কথা পাতিবলৈ ব্ৰাউজাৰ ছেটিংছত ইয়াক অনুমতি দিয়ক।"

msgid "Microphone blocked — allow it in browser settings."
msgstr "মাইক্ৰ'ফোন ব্লক কৰা হৈছে - ব্ৰাউজাৰ ছেটিংছত ইয়াক অনুমতি দিয়ক।"

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "নমস্কে! শস্য, সাৰ, কীট-পতংগ বা চৰকাৰী আঁচনিৰ বিষয়ে মোক সুধিব পাৰে - আপোনাৰ নিজৰ ভাষাত লিখক বা কওক।"

msgid "Namaste! 🙏"
msgstr "নমস্কাৰ! 🙏"

msgid "Network error. Please try again."
msgstr "নেটৱৰ্কৰ ত্ৰুটি। অনুগ্ৰহ কৰি পুনৰ চেষ্টা কৰক।"

msgid "Paused — tap the circle to talk"
msgstr "থামাই থোৱা হৈছে - কথা পাতিবলৈ বৃত্তটো টিপক"

msgid "Send now, interrupt, or resume"
msgstr "এতিয়াই পঠাওক, বাধা দিয়ক বা পুনৰ আৰম্ভ কৰক।"

msgid "Something went wrong."
msgstr "কিবা এটা ভুল হ'ল।"

msgid "Sorry, I didn't catch that."
msgstr "দুঃখিত, মই সেইটো বুজি পোৱা নাই।"

msgid "Source:"
msgstr "উৎস:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "যিকোনো ভাষাত কওক। শেষ কৰাৰ সময়ত অলপ ৰ'ব - মই উত্তৰ দিম আৰু তাৰ পিছত আকৌ শুনিম।"

msgid "Speaking… tap the circle to interrupt"
msgstr "কথা কৈ আছে... বাধা দিবলৈ বৃত্তটো টিপক।"

msgid "Speaking… tap the circle to skip"
msgstr "কথা কৈ আছে... এৰাই চলিবলৈ বৃত্তটো টিপক।"

msgid "Stop"
msgstr "ৰখাওক"

msgid "Thinking…"
msgstr "ভাবি আছোঁ..."

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "অনুবাদটো সাময়িকভাৱে উপলব্ধ নহয়। এই উত্তৰটো ইংৰাজীত দেখুওৱা হৈছে।"

msgid "Type instead"
msgstr "ইয়াৰ পৰিৱৰ্তে টাইপ কৰক"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "এই ব্ৰাউজাৰত কণ্ঠস্বৰৰ কথোপকথন সমৰ্থিত নহয়। অনুগ্ৰহ কৰি আপোনাৰ প্ৰশ্নটো টাইপ কৰক।"

msgid "Voice replies off (tap to turn on)"
msgstr "ভইচ ৰিপ্লাই অফ (চালু কৰিবলৈ টেপ কৰক)"

msgid "Voice replies on (tap to mute)"
msgstr "ভইচ ৰিপ্লাই অন (মিউট কৰিবলৈ টেপ কৰক)"

msgid "Voice typing is not supported in this browser."
msgstr "এই ব্ৰাউজাৰত ভইচ টাইপিং সমৰ্থিত নহয়।"

msgid "Your current location"
msgstr "আপোনাৰ বৰ্তমানৰ অৱস্থান"
