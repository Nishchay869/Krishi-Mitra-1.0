msgid "Converting your speech to text…"
msgstr "तुजें उलोवप मजकुरांत रुपांतरीत करता..."

msgid "Could not save favourites. Please try again."
msgstr "आवडटीं सांबाळूंक शकलें ना. उपकार करून परत यत्न कर."

msgid "Couldn't hear that. Please try again."
msgstr "आयकलेंना तें. परत एकदां घे."

msgid "Dictate: speak and the words appear in the box"
msgstr "आदेश : उलोवचें आनी शब्द बॉक्सांत दिसचे."

msgid "Done speaking"
msgstr "उलयून जालो"

msgid "End"
msgstr "अखेर"

msgid "Finding your location…"
msgstr "तुजी सुवात सोदून काडटा..."

msgid "Krishi Mitra · Live"
msgstr "कृशी मित्र · लायव्ह"

msgid "Listen"
msgstr "आयक"

msgid "Listening…"
msgstr "आयकतां.."

msgid "Listening… speak, then pause or tap ■"
msgstr "आयकुन... उलय, मागीर थांब वा टॅप कर■"

msgid "Live voice conversation"
msgstr "जिवीत आवाज संवाद"

msgid "Location could not be saved. Please try again."
msgstr "सुवात सांबाळूंक शकलेंना. उपकार करून परत यत्न कर."

msgid "Location is unavailable. Please check your browser permissions."
msgstr "सुवात मेळना. उपकार करून तुजे ब्रावझराची परवानगी तपास."

msgid "Market removed from favourites."
msgstr "बाजार आवडीच्या वळेरेंतल्यान काडून उडयला."

msgid "Market saved to favourites."
msgstr "बाजार आवडट्यांक सांबाळून दवरलो."

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "मायक्रोफोन प्रवेश आडायिल्लो. सहाय्यकाकडेन उलोवंक ताका ब्राउझर सेटिंग्सांनी परवानगी दी."

msgid "Microphone blocked — allow it in browser settings."
msgstr "मायक्रोफोन ब्लॉक केल्लो आसा - तो ब्राउझर सेटिंग्सांतल्यान चालू कर."

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "नमस्कार! पिकां, रासायनीक सारें, किडी वा सरकारी येवजण्यां विशीं म्हाका विचार - तुजे भाशेन टायप कर वा उलो."

msgid "Namaste! 🙏"
msgstr "नमस्कार! 🙏"

msgid "Network error. Please try again."
msgstr "नेटवर्क त्रुटी. उपकार करून परत यत्न कर."

msgid "Paused — tap the circle to talk"
msgstr "विराम - उलोवपाक वर्तुळाचेर टॅप कर"

msgid "Send now, interrupt, or resume"
msgstr "आतां धाडचें, आडमेळो घालचो वा परत सुरू करचो"

msgid "Something went wrong."
msgstr "कितें तरी चुकलें."

msgid "Sorry, I didn't catch that."
msgstr "माफ करचें न्ही, म्हाका तें कळ्ळेंना."

msgid "Source:"
msgstr "स्रोतः"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "खंयचेय भाशेंत उलय. तुवें सांगप सोंपलें म्हण्टकच थांब - हांव जाप दितलों आनी मागीर परत आयकतलों."

msgid "Speaking… tap the circle to interrupt"
msgstr "उलयतना... मदीं थांबोवंक वर्तुळाचेर टॅप कर"

msgid "Speaking… tap the circle to skip"
msgstr "उलयतना... वगडावंक वर्तुळाचेर टॅप कर"

msgid "Stop"
msgstr "थांबो"

msgid "Thinking…"
msgstr "विचार करतां.."

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "अनुवाद तात्पुरतो उपलब्ध ना. हें जाप इंग्लीशींत दाखयलां."

msgid "Type instead"
msgstr "हाचे बदला टायप करात"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "ह्या ब्रावझरांत आवाज उलोवपाक आदार ना. उपकार करून तुजो प्रस्न टायप कर."

msgid "Voice replies off (tap to turn on)"
msgstr "आवाज बंद आसा (चालू करपाक टॅप करात)"

msgid "Voice replies on (tap to mute)"
msgstr "आवाज जाप दिता (म्यूट करपाक टॅप करात)"

msgid "Voice typing is not supported in this browser."
msgstr "ह्या ब्रावझरांत व्हॉयस टायपिंगाक आदार ना."

msgid "Your current location"
msgstr "तुजी सद्याची सुवात"
