msgid "Converting your speech to text…"
msgstr "আপনার বক্তব্যকে পাঠ্যে রূপান্তরিত করা হচ্ছে..."

msgid "Could not save favourites. Please try again."
msgstr "পছন্দের জিনিসগুলি সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"

msgid "Couldn't hear that. Please try again."
msgstr "শুনতে পাইনি। আবার চেষ্টা করুন।"

msgid "Dictate: speak and the words appear in the box"
msgstr "নির্দেশনা: বলুন এবং শব্দগুলো বাক্সে প্রদর্শিত হবে।"

msgid "Done speaking"
msgstr "বলা হয়ে গেল।"

msgid "End"
msgstr "শেষ"

msgid "Finding your location…"
msgstr "আপনার অবস্থান খুঁজে বের করা হচ্ছে..."

msgid "Krishi Mitra · Live"
msgstr "কৃষি মিত্র · লাইভ"

msgid "Listen"
msgstr "শুনুন।"

msgid "Listening…"
msgstr "শুনছি..."

msgid "Listening… speak, then pause or tap ■"
msgstr "শুনছি... বলুন, তারপর থামুন অথবা টিপুন।"

msgid "Live voice conversation"
msgstr "সরাসরি কণ্ঠস্বর কথোপকথন"

msgid "Location could not be saved. Please try again."
msgstr "অবস্থান সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"

msgid "Location is unavailable. Please check your browser permissions."
msgstr "অবস্থান উপলব্ধ নয়। অনুগ্রহ করে আপনার ব্রাউজারের অনুমতিগুলি পরীক্ষা করুন।"

msgid "Market removed from favourites."
msgstr "পছন্দের তালিকা থেকে বাজারটি সরানো হয়েছে।"

msgid "Market saved to favourites."
msgstr "পছন্দের তালিকায় বাজারটি সংরক্ষিত হয়েছে।"

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "মাইক্রোফোন অ্যাক্সেস ব্লক করা হয়েছে। সহকারীর সঙ্গে কথা বলার জন্য ব্রাউজারের সেটিংসে এটি অনুমোদন করুন।"

msgid "Microphone blocked — allow it in browser settings."
msgstr "মাইক্রোফোন ব্লক করা হয়েছে - ব্রাউজারের সেটিংসে এটি অনুমোদন করুন।"

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "নমস্কার! ফসল, সার, কীটপতঙ্গ বা সরকারি প্রকল্প সম্পর্কে জিজ্ঞাসা করুন - আপনার নিজের ভাষায় টাইপ করুন বা বলুন।"

msgid "Namaste! 🙏"
msgstr "নমস্কার! 🙏"

msgid "Network error. Please try again."
msgstr "নেটওয়ার্ক ত্রুটি। আবার চেষ্টা করুন।"

msgid "Paused — tap the circle to talk"
msgstr "বিরতি দেওয়া হয়েছে - কথা বলতে বৃত্তটিতে ট্যাপ করুন।"

msgid "Send now, interrupt, or resume"
msgstr "এখন পাঠান, বাধা দিন অথবা আবার শুরু করুন।"

msgid "Something went wrong."
msgstr "কিছু একটা ভুল হয়েছে।"

msgid "Sorry, I didn't catch that."
msgstr "দুঃখিত, আমি সেটা বুঝতে পারিনি।"

msgid "Source:"
msgstr "উৎস:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "যেকোনো ভাষাতেই বলুন। শেষ হলে থামুন - আমি উত্তর দেব এবং তারপর আবার শুনব।"

msgid "Speaking… tap the circle to interrupt"
msgstr "বক্তা... বাধা দেওয়ার জন্য বৃত্তে ট্যাপ করুন।"

msgid "Speaking… tap the circle to skip"
msgstr "বক্তব্য... বাদ দিতে বৃত্তে ট্যাপ করুন"

msgid "Stop"
msgstr "থামো।"

msgid "Thinking…"
msgstr "ভাবছি..."

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "অনুবাদটি সাময়িকভাবে উপলব্ধ নয়। এই উত্তরটি ইংরেজিতে দেখানো হয়েছে।"

msgid "Type instead"
msgstr "পরিবর্তে টাইপ করুন"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "এই ব্রাউজারে কণ্ঠস্বর-ভিত্তিক কথোপকথন সমর্থিত নয়। অনুগ্রহ করে আপনার প্রশ্নটি টাইপ করুন।"

msgid "Voice replies off (tap to turn on)"
msgstr "ভয়েস রিপ্লাই বন্ধ (চালু করতে ট্যাপ করুন)"

msgid "Voice replies on (tap to mute)"
msgstr "ভয়েস রিপ্লাই চালু আছে (মিউট করতে ট্যাপ করুন)"

msgid "Voice typing is not supported in this browser."
msgstr "এই ব্রাউজারে ভয়েস টাইপিং সমর্থিত নয়।"

msgid "Your current location"
msgstr "আপনার বর্তমান অবস্থান"
