msgid "Converting your speech to text…"
msgstr "پنٕنۍ تقریر تحریرَس منٛز تبدیل کرُن..."

msgid "Could not save favourites. Please try again."
msgstr "پسندیدٕ بچاوِتھ ہیو٘ك نہٕ ۔ مہربٲنی کٔرتھ کٔرِیو بییہ کوٗشش۔"

msgid "Couldn't hear that. Please try again."
msgstr "بہٕ گوس نہٕ یہ بوزنہ۔ مہربٲنی کٔرتھ کرِو بییہ کوٗشش۔"

msgid "Dictate: speak and the words appear in the box"
msgstr "حُکُم : کَتھ کٔرِو تہٕ لَفٕظ چھِ ڈَبس منٛز ظٲہِر گَژھان۔"

msgid "Done speaking"
msgstr "بولٗن گوٚو۔"

msgid "End"
msgstr "خَتَم"

msgid "Finding your location…"
msgstr "پنٕنۍ مقام ژھانٛڈُن..."

msgid "Krishi Mitra · Live"
msgstr "کرشی مِتر ۔ لائیو"

msgid "Listen"
msgstr "بوزِو۔"

msgid "Listening…"
msgstr "بوزُن..."

msgid "Listening… speak, then pause or tap ■"
msgstr "بوزُن... کَتھ کٔرِو، پتہٕ رُکِو یا ٹیپ کٔرِو ■"

msgid "Live voice conversation"
msgstr "زندٕ آوازِ سۭتۍ کتھ باتھ"

msgid "Location could not be saved. Please try again."
msgstr "مقام ہیکہ نہٕ بچاوِتھ۔ مہربٲنی کٔرِتھ کٔریو بییہ کوٗشش۔"

msgid "Location is unavailable. Please check your browser permissions."
msgstr "مقام چھُنہٕ دستیاب۔ مہربٲنی کٔرِتھ وٗچھِو پننِہِ  برٛاوٗزَر اِجازت۔"

msgid "Market removed from favourites."
msgstr "بازار آو پسندیدٕ جایہ پیٹھ ہٹاونہٕ۔"

msgid "Market saved to favourites."
msgstr "مارکیٹ بچاو فِیورایٹسس منٛز۔"

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "مائیکروفون رسٲیی آیہِ رُکاونہٕ۔ معاونس سۭتۍ کتھ کرنہٕ خٲطرٕ دیوٗ یہِ براؤزر سیٹنگن منٛز اجازت۔"

msgid "Microphone blocked — allow it in browser settings."
msgstr "مائیکروفون چھُ بند کرنہٕ آمُت-برٛاؤزر سیٹنگز منٛز دیو اتھ اجازت۔"

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "نمستے! مےٚ پرژھو فصل، کھاد، کیمیا یا سرکٲرۍ سکیمن متعلق- ٹایپ کٔرو یا پنٛنہ زبانہ منٛز کتھ کرو۔"

msgid "Namaste! 🙏"
msgstr "نمستے! 🙏"

msgid "Network error. Please try again."
msgstr "نیٹ ورک ایرر۔ مہربٲنی کٔرتھ کٔرو بییہ کوٗشش۔"

msgid "Paused — tap the circle to talk"
msgstr "رُکٲوِتھ- کتھ کرنہٕ خٲطرٕ کٔرِیو دٲیرس پیٹھ ٹیپ۔"

msgid "Send now, interrupt, or resume"
msgstr "وۄنۍ سوزِیو٘ ، رٗکاوٗن، یا بییہ شروع کٔرِو ۔"

msgid "Something went wrong."
msgstr "کٮ۪نٛہہ گٔیہ غلط۔"

msgid "Sorry, I didn't catch that."
msgstr "معاف کٔرِو، مےٚ ووت نہٕ یہ۔"

msgid "Source:"
msgstr "ماخذ:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "کٔنہِ تہِ زبانہِ منٛز کٔرِو کتھ۔ ییٚلہِ تو٘ہہِ مٗکمل كرِیو٘  رُکِو- بہٕ دِیٗس جواب تہٕ پتہٕ بوزِو بییہ ۔"

msgid "Speaking… tap the circle to interrupt"
msgstr "بولُن... رُکاونہٕ خٲطرٕ دباوِیو دٲیرس پیٹھ ٹیپ۔"

msgid "Speaking… tap the circle to skip"
msgstr "بولُن... ژلنہٕ خٲطرٕ دبٲوِیو دٲیرس پیٹھ ٹیپ۔"

msgid "Stop"
msgstr "رُک۔"

msgid "Thinking…"
msgstr "سوچِتھ ۔"

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "ترجمہٕ چھُ عارضی طور دٔستیاب نہٕ۔ یہِ جواب چُھ انگریزی منٛز ہاونہٕ آمُت۔"

msgid "Type instead"
msgstr "امہ بجایہ ٹایپ کٔرِو۔"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "اتھ براؤزرس منٛز چھنہٕ آوازِ ہندِ کتھ باتھ حیمایت کرنہٕ یوان۔ مہربٲنی کٔرتھ ٹایپ کٔرِو پنُن سوال۔"

msgid "Voice replies off (tap to turn on)"
msgstr "آوازٕچ جواب چھ بند (آن کرنہٕ خٲطرٕ ٹِپ کٔرِو)"

msgid "Voice replies on (tap to mute)"
msgstr "آوازٕچ جواب (میوٗٹ کرنہٕ خٲطرٕ ٹیپ کٔرِیو)"

msgid "Voice typing is not supported in this browser."
msgstr "اتھ براؤزرس منٛز چھنہٕ وایس ٹائپنگ سپورٹ کرنہٕ یوان۔"

msgid "Your current location"
msgstr "تٗہٗند موُجوُدٕ مقام"
