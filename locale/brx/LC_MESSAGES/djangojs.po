msgid ""
msgstr "Project-Id-Version: Krishi Mitra\nLanguage: brx\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Converting your speech to text…"
msgstr "नोंनि बिबुंथिखौ लिरनायाव सोलायगासिनो दं..."

msgid "Could not save favourites. Please try again."
msgstr "फवेरेट्सखौ सेभ खालामनो हायाखै। अन्नानै फिन नाजा।"

msgid "Couldn't hear that. Please try again."
msgstr "बेखौ खोनानो हायाखैमोन। अन्नानै फिन नाजा।"

msgid "Dictate: speak and the words appear in the box"
msgstr "बुंथिनाय: बुं आरो सोदोबफोरा बाक्सुआव नुजायो।"

msgid "Done speaking"
msgstr "बुंनानै जाबाय।"

msgid "End"
msgstr "जोबथा"

msgid "Finding your location…"
msgstr "नोंनि जायगाखौ नागिरनाय जादों..."

msgid "Krishi Mitra · Live"
msgstr "कृषि मित्र · लाइभ"

msgid "Listen"
msgstr "खोनास"

msgid "Listening…"
msgstr "खोनासंनाय..."

msgid "Listening… speak, then pause or tap ■"
msgstr "खोनासंनाय... बुं, बेनि उनाव थाद' एबा थु।"

msgid "Live voice conversation"
msgstr "गोथां गारां रायज्लायनाय"

msgid "Location could not be saved. Please try again."
msgstr "थावनिखौ दोनथ'नो हायाखै। अन्नानै फिन नाजा।"

msgid "Location is unavailable. Please check your browser permissions."
msgstr "थावनिया मोननो हाया। अन्नानै नोंनि ब्राउजारनि गनायथिफोरखौ नायसं।"

msgid "Market removed from favourites."
msgstr "मार्केटा फेभारेतफोरनिफ्राय बोखारजाबाय।"

msgid "Market saved to favourites."
msgstr "मार्केटा मोजां मोननायफोरनि थाखाय रैखाथि होदों।"

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "माइक्र'फननि खाबुखौ होबथानाय जादोंमोन। हेफाजाबारिजों रायज्लायनो थाखाय बेखौ ब्राउजारनि सेटिंआव गनायथि हो।"

msgid "Microphone blocked — allow it in browser settings."
msgstr "माइक्र'फनखौ होबथानाय जादों - बेखौ ब्राउजार सेटिंआव गनायथि हो।"

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "नमेस्ते। आंनाव फसलफोर, हासारफोर, खहा-खालामग्रा एबा सोरखारि बिथांखिफोरनि सोमोनदै सों – नोंनि गावनिनो रावआव टाइप खालाम एबा बुं।"

msgid "Namaste! 🙏"
msgstr "नमसते! 🙏"

msgid "Network error. Please try again."
msgstr "नेथवर्क गोरोन्थि। अन्नानै फिन नाजा।"

msgid "Paused — tap the circle to talk"
msgstr "थाद'नाय - रायज्लायनो थाखाय बेंखनखौ थु।"

msgid "Send now, interrupt, or resume"
msgstr "दा हरहर, होबथा एबा फिन जागायफिन।"

msgid "Something went wrong."
msgstr "माबा मोनसे गोरोन्थि जादोंमोन।"

msgid "Sorry, I didn't catch that."
msgstr "निमाहा होदो, आं बेखौ हमनो हायाखै।"

msgid "Source:"
msgstr "फुंखा:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "जायखिजाया रावाव रायलाय। जेब्ला फोजोबगोन अब्ला थाद'नांगोन - आं फिन होगोन आरो बेनि उनाव फिन खोनासैगोन।"

msgid "Speaking… tap the circle to interrupt"
msgstr "बुंनाय... होबथानो थाखाय बेंखनखौ थु।"

msgid "Speaking… tap the circle to skip"
msgstr "बुंनाय... नागारनो थाखाय बेंखनखौ थु।"

msgid "Stop"
msgstr "थाद'"

msgid "Thinking…"
msgstr "साननानै..."

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "रावस्लायनाया दान्दिसेनि थाखाय गैया। बे फिननाया इंराजियाव दिन्थिजादों।"

msgid "Type instead"
msgstr "बेनि सोलाय टाइप खालाम।"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "बे ब्राउजाराव गारां सावरायनाया मदद होजाया। अन्नानै नोंथांनि सोंलुखौ टाइप खालाम।"

msgid "Voice replies off (tap to turn on)"
msgstr "गारांनि फिननाय अफ (अन खालामनो थाखाय टेप खालाम)"

msgid "Voice replies on (tap to mute)"
msgstr "गारांनि फिननायफोरा (माउथ खालामनो टेप खालाम)"

msgid "Voice typing is not supported in this browser."
msgstr "बे ब्राउजाराव भइस टाइपिंआ मदद होजाया।"

msgid "Your current location"
msgstr "नोंनि आथिखाल थावनिया"
