msgid "Converting your speech to text…"
msgstr "તમારા ભાષણને લખાણમાં રૂપાંતરિત કરી રહ્યા છીએ..."

msgid "Could not save favourites. Please try again."
msgstr "મનપસંદ વસ્તુઓ સાચવી શકાય નથી. કૃપા કરીને ફરી પ્રયાસ કરો."

msgid "Couldn't hear that. Please try again."
msgstr "તે સાંભળી શક્યા નહીં. કૃપા કરીને ફરી પ્રયાસ કરો."

msgid "Dictate: speak and the words appear in the box"
msgstr "આદેશ આપોઃ બોલો અને શબ્દો પેટીમાં દેખાય છે"

msgid "Done speaking"
msgstr "બોલવાનું પૂરું થયું"

msgid "End"
msgstr "અંત"

msgid "Finding your location…"
msgstr "તમારું સ્થાન શોધી રહ્યું છે..."

msgid "Krishi Mitra · Live"
msgstr "કૃષિમિત્ર · લાઈવ"

msgid "Listen"
msgstr "સાંભળો"

msgid "Listening…"
msgstr "સાંભળવું..."

msgid "Listening… speak, then pause or tap ■"
msgstr "સાંભળવું... બોલો, પછી થોભો અથવા ટૅપ કરો"

msgid "Live voice conversation"
msgstr "જીવંત અવાજની વાતચીત"

msgid "Location could not be saved. Please try again."
msgstr "સ્થાન સાચવી શકાયું નથી. કૃપા કરીને ફરી પ્રયાસ કરો."

msgid "Location is unavailable. Please check your browser permissions."
msgstr "સ્થાન ઉપલબ્ધ નથી. કૃપા કરીને તમારા બ્રાઉઝરની પરવાનગીઓ તપાસો."

msgid "Market removed from favourites."
msgstr "બજારને મનપસંદમાંથી દૂર કરવામાં આવ્યું છે."

msgid "Market saved to favourites."
msgstr "માર્કેટ ફેવરિટમાં સાચવેલ છે."

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "માઇક્રોફોન ઍક્સેસ બ્લોક કરવામાં આવી હતી. સહાયક સાથે વાત કરવા માટે બ્રાઉઝર સેટિંગ્સમાં તેને મંજૂરી આપો."

msgid "Microphone blocked — allow it in browser settings."
msgstr "માઇક્રોફોન બ્લોક છે- તેને બ્રાઉઝર સેટિંગ્સમાં મંજૂરી આપો."

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "નમસ્તે! પાક, ખાતર, જીવાતો અથવા સરકારી યોજનાઓ વિશે મને પૂછો - તમારી પોતાની ભાષામાં લખો અથવા બોલો."

msgid "Namaste! 🙏"
msgstr "નમસ્તે! 🙏"

msgid "Network error. Please try again."
msgstr "નેટવર્ક ભૂલ. કૃપા કરીને ફરી પ્રયાસ કરો."

msgid "Paused — tap the circle to talk"
msgstr "થંભાવેલું-વાત કરવા માટે વર્તુળ પર ટેપ કરો"

msgid "Send now, interrupt, or resume"
msgstr "હમણાં મોકલો, વિક્ષેપ કરો અથવા ફરી શરૂ કરો"

msgid "Something went wrong."
msgstr "કંઈક ખોટું થયું છે."

msgid "Sorry, I didn't catch that."
msgstr "માફ કરશો, હું તે પકડી શક્યો નથી."

msgid "Source:"
msgstr "સ્ત્રોતઃ"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "કોઈ પણ ભાષામાં બોલો. જ્યારે તમે પૂરું કરો ત્યારે થોભો-હું જવાબ આપીશ અને પછી ફરીથી સાંભળીશ."

msgid "Speaking… tap the circle to interrupt"
msgstr "બોલી રહ્યા છે... વિક્ષેપ પાડવા માટે વર્તુળ પર ટેપ કરો"

msgid "Speaking… tap the circle to skip"
msgstr "બોલી રહ્યા છે... છોડવા માટે વર્તુળ પર ટેપ કરો"

msgid "Stop"
msgstr "થોભો"

msgid "Thinking…"
msgstr "વિચારવું..."

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "અનુવાદ અસ્થાયી રૂપે ઉપલબ્ધ નથી. આ જવાબ અંગ્રેજીમાં બતાવવામાં આવ્યો છે."

msgid "Type instead"
msgstr "તેના બદલે લખો"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "આ બ્રાઉઝરમાં અવાજની વાતચીતને સમર્થન નથી. કૃપા કરીને તમારો પ્રશ્ન લખો."

msgid "Voice replies off (tap to turn on)"
msgstr "વૉઇસ રિપ્લાય બંધ છે (ચાલુ કરવા માટે ટેપ કરો)"

msgid "Voice replies on (tap to mute)"
msgstr "(મ્યૂટ કરવા માટે ટેપ કરો) અવાજ જવાબ આપે છે"

msgid "Voice typing is not supported in this browser."
msgstr "આ બ્રાઉઝરમાં વોઈસ ટાઈપિંગ સપોર્ટેડ નથી."

msgid "Your current location"
msgstr "તમારું વર્તમાન સ્થાન"
