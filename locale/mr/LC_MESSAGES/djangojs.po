msgstr "Project-Id-Version: Krishi Mitra\nLanguage: mr\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Converting your speech to text…"
msgstr "तुमचे बोलणे मजकुरात बदलत आहे…"

msgid "Could not save favourites. Please try again."
msgstr "आवडीचे जतन करता आले नाही. कृपया पुन्हा प्रयत्न करा."

msgid "Couldn't hear that. Please try again."
msgstr "ऐकू आले नाही. पुन्हा प्रयत्न करा."

msgid "Dictate: speak and the words appear in the box"
msgstr "बोला, शब्द चौकटीत दिसतील"

msgid "Done speaking"
msgstr "बोलून झाले"

msgid "End"
msgstr "समाप्त करा"

msgid "Finding your location…"
msgstr "तुमचे ठिकाण शोधले जात आहे..."

msgid "Krishi Mitra · Live"
msgstr "कृषी मित्र · थेट"

msgid "Listen"
msgstr "ऐका"

msgid "Listening…"
msgstr "ऐकत आहे…"

msgid "Listening… speak, then pause or tap ■"
msgstr "ऐकत आहे… बोला, मग थांबा किंवा ■ दाबा"

msgid "Live voice conversation"
msgstr "थेट आवाजातील संभाषण"

msgid "Location could not be saved. Please try again."
msgstr "स्थान जतन करता आले नाही. कृपया पुन्हा प्रयत्न करा."

msgid "Location is unavailable. Please check your browser permissions."
msgstr "स्थळ उपलब्ध नाही. कृपया तुमच्या ब्राउझरच्या अनुमती तपासा."

msgid "Market removed from favourites."
msgstr "बाजार पसंतीतून काढून टाकला आहे."

msgid "Market saved to favourites."
msgstr "बाजार आवडीच्या वस्तूंसाठी जतन केले."

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "मायक्रोफोनची परवानगी नाही. बोलण्यासाठी ब्राउझर सेटिंगमध्ये परवानगी द्या."

msgid "Microphone blocked — allow it in browser settings."
msgstr "मायक्रोफोन बंद आहे — ब्राउझर सेटिंगमध्ये परवानगी द्या."

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "नमस्कार! पिके, खते, कीड किंवा सरकारी योजनांबद्दल तुमच्या भाषेत लिहून किंवा बोलून विचारा."

msgid "Namaste! 🙏"
msgstr "नमस्कार! 🙏"

msgid "Network error. Please try again."
msgstr "नेटवर्क समस्या. पुन्हा प्रयत्न करा."

msgid "Paused — tap the circle to talk"
msgstr "विराम — बोलण्यासाठी गोल बटण दाबा"

msgid "Send now, interrupt, or resume"
msgstr "आता पाठवा, थांबवा किंवा पुन्हा सुरू करा"

msgid "Something went wrong."
msgstr "काहीतरी चुकले."

msgid "Sorry, I didn't catch that."
msgstr "स्पष्ट ऐकू आले नाही. पुन्हा बोला."

msgid "Source:"
msgstr "स्रोत:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "कोणत्याही भाषेत बोला. पूर्ण झाल्यावर थांबा — उत्तर दिल्यावर पुन्हा ऐकेन."

msgid "Speaking… tap the circle to interrupt"
msgstr "बोलत आहे… थांबवण्यासाठी गोल बटण दाबा"

msgid "Speaking… tap the circle to skip"
msgstr "बोलत आहे… वगळण्यासाठी गोल बटण दाबा"

msgid "Stop"
msgstr "थांबवा"

msgid "Thinking…"
msgstr "विचार करत आहे…"

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "भाषांतर तात्पुरते उपलब्ध नाही. हे उत्तर इंग्रजीत दाखवले आहे."

msgid "Type instead"
msgstr "त्याऐवजी लिहा"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "या ब्राउझरमध्ये आवाजातील संभाषण चालत नाही. प्रश्न लिहा."

msgid "Voice replies off (tap to turn on)"
msgstr "आवाजातील उत्तरे बंद (सुरू करण्यासाठी दाबा)"

msgid "Voice replies on (tap to mute)"
msgstr "आवाजातील उत्तरे सुरू (बंद करण्यासाठी दाबा)"

msgid "Voice typing is not supported in this browser."
msgstr "या ब्राउझरमध्ये आवाजाने लिहिणे चालत नाही."

msgid "Your current location"
msgstr "तुमचे सध्याचे ठिकाण"
