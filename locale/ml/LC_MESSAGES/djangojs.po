msgid "Converting your speech to text…"
msgstr "നിങ്ങളുടെ സംഭാഷണം ടെക്സ്റ്റ് ആക്കി മാറ്റുന്നു..."

msgid "Could not save favourites. Please try again."
msgstr "ഫേവറിറ്റുകൾ സേവ് ചെയ്യാൻ കഴിഞ്ഞില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."

msgid "Couldn't hear that. Please try again."
msgstr "അത് കേൾക്കാൻ കഴിഞ്ഞില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."

msgid "Dictate: speak and the words appear in the box"
msgstr "നിർദ്ദേശം: സംസാരിക്കുക, വാക്കുകൾ ബോക്സിൽ ദൃശ്യമാകും."

msgid "Done speaking"
msgstr "സംസാരിച്ചു തീർത്തു"

msgid "End"
msgstr "അവസാനം"

msgid "Finding your location…"
msgstr "നിങ്ങളുടെ സ്ഥാനം കണ്ടെത്തുന്നു..."

msgid "Krishi Mitra · Live"
msgstr "കൃഷി മിത്ര · ലൈവ്"

msgid "Listen"
msgstr "ശ്രദ്ധിക്കുക"

msgid "Listening…"
msgstr "കേൾക്കുന്നു..."

msgid "Listening… speak, then pause or tap ■"
msgstr "കേൾക്കുന്നു... സംസാരിക്കുക, എന്നിട്ട് നിർത്തുക അല്ലെങ്കിൽ ടാപ്പ് ചെയ്യുക"

msgid "Live voice conversation"
msgstr "തത്സമയ ശബ്ദ സംഭാഷണം"

msgid "Location could not be saved. Please try again."
msgstr "ലൊക്കേഷൻ സേവ് ചെയ്യാൻ കഴിഞ്ഞില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."

msgid "Location is unavailable. Please check your browser permissions."
msgstr "ലൊക്കേഷൻ ലഭ്യമല്ല. നിങ്ങളുടെ ബ്രൗസർ അനുമതികൾ പരിശോധിക്കുക."

msgid "Market removed from favourites."
msgstr "ഫേവറിറ്റുകളിൽ നിന്ന് മാർക്കറ്റ് നീക്കം ചെയ്തു."

msgid "Market saved to favourites."
msgstr "മാർക്കറ്റ് ഫേവറിറ്റുകളിലേക്ക് സേവ് ചെയ്തു."

msgid "Microphone access was blocked. Allow it in the browser settings to talk to the assistant."
msgstr "മൈക്രോഫോൺ ആക്‌സസ് തടഞ്ഞിരിക്കുന്നു. അസിസ്റ്റൻ്റിനോട് സംസാരിക്കാൻ ബ്രൗസർ ക്രമീകരണങ്ങളിൽ അത് അനുവദിക്കുക."

msgid "Microphone blocked — allow it in browser settings."
msgstr "മൈക്രോഫോൺ ബ്ലോക്ക് ചെയ്തു - ബ്രൌസർ ക്രമീകരണങ്ങളിൽ ഇത് അനുവദിക്കുക."

msgid "Namaste! Ask me about crops, fertilizers, pests or government schemes — type or speak in your own language."
msgstr "നമസ്തേ! വിളകൾ, വളങ്ങൾ, കീടങ്ങൾ അല്ലെങ്കിൽ സർക്കാർ പദ്ധതികൾ എന്നിവയെക്കുറിച്ച് എന്നോട് ചോദിക്കുക - നിങ്ങളുടെ സ്വന്തം ഭാഷയിൽ ടൈപ്പ് ചെയ്യുകയോ സംസാരിക്കുകയോ ചെയ്യുക."

msgid "Namaste! 🙏"
msgstr "നമസ്തേ! 🙏"

msgid "Network error. Please try again."
msgstr "നെറ്റ്‌വർക്ക് പിശക്. ദയവായി വീണ്ടും ശ്രമിക്കുക."

msgid "Paused — tap the circle to talk"
msgstr "തടസ്സപ്പെട്ടു - സംസാരിക്കാൻ വൃത്തത്തിൽ ടാപ്പുചെയ്യുക"

msgid "Send now, interrupt, or resume"
msgstr "ഇപ്പോൾ അയക്കുക, തടസ്സപ്പെടുത്തുക അല്ലെങ്കിൽ പുനരാരംഭിക്കുക"

msgid "Something went wrong."
msgstr "എന്തോ തെറ്റി."

msgid "Sorry, I didn't catch that."
msgstr "ക്ഷമിക്കണം, എനിക്കത് മനസ്സിലായില്ല."

msgid "Source:"
msgstr "ഉറവിടം:"

msgid "Speak in any language. Pause when you finish — I'll answer and then listen again."
msgstr "ഏത് ഭാഷയിലും സംസാരിക്കുക. നിങ്ങൾ പൂർത്തിയാക്കുമ്പോൾ നിർത്തുക - ഞാൻ ഉത്തരം നൽകുകയും തുടർന്ന് വീണ്ടും കേൾക്കുകയും ചെയ്യും."

msgid "Speaking… tap the circle to interrupt"
msgstr "സംസാരിക്കുന്നു... തടസ്സപ്പെടുത്താൻ സർക്കിളിൽ ടാപ്പുചെയ്യുക"

msgid "Speaking… tap the circle to skip"
msgstr "സംസാരിക്കുന്നു... ഒഴിവാക്കാൻ വൃത്തത്തിൽ ടാപ്പുചെയ്യുക"

msgid "Stop"
msgstr "നിർത്തുക"

msgid "Thinking…"
msgstr "ചിന്തിക്കുന്നു..."

msgid "Translation is temporarily unavailable. This answer is shown in English."
msgstr "വിവർത്തനം താൽക്കാലികമായി ലഭ്യമല്ല. ഈ ഉത്തരം ഇംഗ്ലീഷിൽ കാണിച്ചിരിക്കുന്നു."

msgid "Type instead"
msgstr "പകരം ടൈപ്പ് ചെയ്യുക"

msgid "Voice conversation is not supported in this browser. Please type your question."
msgstr "ഈ ബ്രൌസറിൽ വോയിസ് സംഭാഷണം പിന്തുണയ്ക്കുന്നില്ല. ദയവായി നിങ്ങളുടെ ചോദ്യം ടൈപ്പ് ചെയ്യുക."

msgid "Voice replies off (tap to turn on)"
msgstr "വോയിസ് മറുപടികൾ ഓഫാണ് (ഓണാക്കാൻ ടാപ്പ് ചെയ്യുക)"

msgid "Voice replies on (tap to mute)"
msgstr "വോയിസ് മ്യൂട്ട് ചെയ്യുക"

msgid "Voice typing is not supported in this browser."
msgstr "ഈ ബ്രൌസറിൽ വോയിസ് ടൈപ്പിംഗ് പിന്തുണയ്ക്കുന്നില്ല."

msgid "Your current location"
msgstr "നിങ്ങളുടെ ഇപ്പോഴത്തെ സ്ഥാനം"
