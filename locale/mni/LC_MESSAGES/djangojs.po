msgid "Source:"
msgstr "ꯂꯤꯈꯨꯟ ꯑꯁꯤ ꯃꯅꯝ ꯅꯨꯡꯁꯤꯕ ꯄꯣꯠ ꯑꯃꯅꯤ꯫"

